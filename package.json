{
  "name": "agent-personalizer",
  "version": "0.6.1",
  "description": "One interview writes a profile and rule files every AI you use reads: CLAUDE.md, AGENTS.md, GEMINI.md and ChatGPT, kept in sync from one source.",
  "author": "aunysillyme (https://github.com/aunysillyme)",
  "license": "MIT",
  "repository": "github:aunysillyme/agent-personalizer",
  "homepage": "https://github.com/aunysillyme/agent-personalizer#readme",
  "bugs": {
    "url": "https://github.com/aunysillyme/agent-personalizer/issues"
  },
  "keywords": [
    "ai-agents",
    "custom-instructions",
    "agents-md",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "chatgpt",
    "personalization",
    "agent-onboarding",
    "dynamic-instructions"
  ],
  "bin": {
    "agent-personalizer": "bin/agent-personalizer.js"
  },
  "scripts": {
    "render": "node render/render.cjs --dir examples/freelance-illustrator",
    "check": "node render/render.cjs --dir examples/freelance-illustrator --check",
    "gate": "node check/gate.cjs",
    "test": "sh test/run.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "render",
    "rules",
    "templates",
    "hooks",
    "check/gate.cjs",
    "check/forbidden.example.txt",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "llms.txt"
  ]
}
